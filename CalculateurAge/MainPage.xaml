<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalculateurAge.MainPage"
             Title="Calculateur">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <!-- Boutons thème et effacer en haut -->
            <HorizontalStackLayout Spacing="10">
                <Button Text="Basculer Thème" 
                        Command="{Binding BasculerThemeCommand}"
                        HorizontalOptions="FillAndExpand"/>
                <Button Text="Effacer" 
                        Command="{Binding EffacerCommand}"
                        HorizontalOptions="FillAndExpand"/>
            </HorizontalStackLayout>

            <!-- Formulaire principal -->
            <Label Text="Nom" FontSize="16"/>
            <Entry Text="{Binding Nom, Mode=TwoWay}"
                   Placeholder="Votre nom"/>
            <Label Text="Date de naissance" FontSize="16"/>
            <DatePicker Date="{Binding DateNaissance, Mode=TwoWay}"/>
            <Button Text="Calculer"
                    Command="{Binding CalculerCommand}"/>

            <!-- Résultat et jours restants -->
            <Label Text="{Binding Resultat}" FontSize="20"
                   IsVisible="{Binding ResultatVisible}"/>
            <Label Text="{Binding JoursRestants}" FontSize="16"
                   IsVisible="{Binding ResultatVisible}"/>

            <!-- Historique -->
            <Label Text="Historique des calculs" FontSize="16" FontAttributes="Bold"
                   IsVisible="{Binding Historique.Count}"/>
            <CollectionView ItemsSource="{Binding Historique}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <StackLayout Padding="10" Spacing="5" BackgroundColor="#f0f0f0">
                            <Label Text="{Binding .}" FontSize="14"/>
                        </StackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Bouton vider l'historique -->
            <Button Text="Vider l'historique" 
                    Command="{Binding ViderHistoriqueCommand}"
                    IsVisible="{Binding Historique.Count}"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
